# Recommended for 8 × H100 single-node — see plan/06 §5.
# Sourced by every launcher script. Identical across single- and multi-node
# so there's no env drift.
export NCCL_AVOID_RECORD_STREAMS=1
export NCCL_NVLS_ENABLE=1
export NCCL_IB_DISABLE=1                 # no IB on single-node
export NCCL_P2P_DISABLE=0
export TORCH_NCCL_AVOID_RECORD_STREAMS=1
export TORCH_NCCL_ASYNC_ERROR_HANDLING=1
export TORCH_DISTRIBUTED_DEBUG=OFF       # turn ON only when debugging
export CUDA_DEVICE_MAX_CONNECTIONS=1     # for proper TP overlap (harmless w/ TP=1)
export OMP_NUM_THREADS=8
